      "source": [
        "from bs4 import BeautifulSoup\n",
        "import requests\n",
        "\n",
        "response = requests.get('https://www.wikipedia.org/')\n",
        "soup = BeautifulSoup(response.text, 'html.parser')\n",
        "\n",
        "# Encontrar todos os links\n",
        "for link in soup.find_all('a'):\n",
        "    print(link.get('href'))"
      ]
    }
  ]
