      "source": [
        "import cv2\n",
        "\n",
        "# Carregar a imagem\n",
        "image = cv2.imread('exemplo.jpg')\n",
        "\n",
        "# Converter para escala de cinza\n",
        "gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "# Exibir a imagem\n",
        "cv2.imshow('Imagem', gray_image)\n",
        "cv2.waitKey(0)\n",
        "cv2.destroyAllWindows()"
      ]
    }
  ]
}