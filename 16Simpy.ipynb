      "source": [
        "from sympy import symbols, Eq, solve\n",
        "\n",
        "# Definir símbolos\n",
        "x = symbols('x')\n",
        "\n",
        "# Criar uma equação\n",
        "equacao = Eq(x**2 - 4, 0)\n",
        "\n",
        "# Resolver a equação\n",
        "solucoes = solve(equacao)\n",
        "print(solucoes)"
      ]
    }
  ]
}